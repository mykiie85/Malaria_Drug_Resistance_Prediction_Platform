# Copy to .env and fill in real values before running:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Generate SECRET_KEY with: openssl rand -hex 32
# Generate POSTGRES_PASSWORD with: openssl rand -hex 16

SECRET_KEY=
POSTGRES_PASSWORD=

# Host port the frontend (and proxied /api/) will be reachable on.
# Check it's free on the VPS first: ss -tlnp | grep <port>
FRONTEND_PORT=8090

# Origin the app is served from — only needed if something calls the API
# cross-origin (browser same-origin requests through nginx don't need this).
CORS_ORIGINS=http://YOUR_VPS_IP:8090
